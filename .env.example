# FalkorDB
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
GRAPH=claimbridge

# Coordination
LEASE_TTL_S=20
HEARTBEAT_S=5
POLL_S=1
STEP_DELAY_S=0

# LLM
#   LLM_PLATFORM: groq (default) | openai | claude | fake
#   LLM_MODE:     cached (replay recorded responses, call on a miss) | live | offline
#   LLM_MODEL:    optional override. Defaults: groq openai/gpt-oss-120b, openai gpt-5-mini,
#                 claude claude-opus-5-5
LLM_PLATFORM=groq
LLM_MODE=cached
LLM_MODEL=
LLM_REASONING_EFFORT=medium
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Host ports (all bound to localhost). Change them to run a second copy side by side.
# WEB_PORT=3100
# API_PORT=8000
# DB_PORT=6379
# DB_UI_PORT=3000

# Access: demo exposes fictional scenarios and operator controls to everyone.
# For a private instance use protected and generate different random tokens per user.
# Example JSON shape (replace the placeholder with at least 32 random characters):
# {"TOKEN":{"subject":"caseworker","role":"admin"},"TOKEN2":{"subject":"alice","role":"tenant","tenant_id":"TEN-01"}}
AUTH_MODE=demo
AUTH_CREDENTIALS_JSON=
# Set 1 behind HTTPS; local HTTP needs 0.
COOKIE_SECURE=0

# Investigator: comma-separated models to try, in order, when the provider answers 429 (rate limit).
# LLM_MODEL_FALLBACKS=
